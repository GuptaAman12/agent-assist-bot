ASSEMBLYAI_API_KEY=your_assembly_ai_key
GROQ_API_KEY=your_groq_api_key

# Optional overrides
# ADMIN_TOKEN=                # if set, /kb/* requires this as X-Admin-Token header
# GROQ_MODEL=openai/gpt-oss-20b

# Human handoff (speak_to_agent / no-match): deliver the ticket via webhook OR email.
# HANDOFF_WEBHOOK_URL=
# HANDOFF_EMAIL_TO=
# HANDOFF_EMAIL_FROM=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# HANDOFF_TIMEOUT_SEC=10
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# KB_MIN_SIMILARITY=0.45
# GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# GROQ_TTS_VOICE=troy
# RATE_LIMIT_WINDOW_SEC=60
# RATE_LIMIT_MAX_REQUESTS=20
# RATE_LIMIT_MAX_TRANSCRIBE=10
# AUDIT_LOG_PATH=knowledge_base.log.jsonl
# HANDOFF_QUEUE_PATH=handoff_queue.jsonl
